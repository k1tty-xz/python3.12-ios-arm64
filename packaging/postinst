#!/bin/sh
set -eu

if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
    cyan=$(printf '\033[36m')
    green=$(printf '\033[32m')
    yellow=$(printf '\033[33m')
    reset=$(printf '\033[0m')
else
    cyan=''
    green=''
    yellow=''
    reset=''
fi

printf '%s Python for iOS%s\n' "$cyan" "$reset"
printf '  Preparing HTTPS certificates...\n'

# Add the CA link only when the standard path is missing.
if [ ! -e /etc/ssl/cert.pem ] && [ ! -L /etc/ssl/cert.pem ] && [ -r /etc/ssl/certs/cacert.pem ]; then
    ln -s /etc/ssl/certs/cacert.pem /etc/ssl/cert.pem
    printf '  %s[ok]%s Linked /etc/ssl/cert.pem to the system CA bundle.\n' "$green" "$reset"
elif [ -e /etc/ssl/cert.pem ] || [ -L /etc/ssl/cert.pem ]; then
    printf '  %s[ok]%s Existing CA path is ready.\n' "$green" "$reset"
else
    printf '  %s[warning]%s No CA bundle found; HTTPS pip installs may fail.\n' "$yellow" "$reset"
fi

printf '%s Installation complete.%s\n' "$cyan" "$reset"
exit 0
